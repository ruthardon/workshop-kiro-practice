{
  "name": "claimshield-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de ClaimShield - gestión de siniestros",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.reporter=lcov",
    "db:reset": "tsx scripts/db-reset.ts",
    "start:sqlite": "tsx src/server.ts",
    "dev:sqlite": "tsx watch src/server.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "cors": "2.8.5",
    "express": "4.21.2",
    "pg": "8.13.1",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.7",
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
