# Copia este archivo a .env si quieres personalizar valores (solo aplica al modo Docker)
# Motor de BD del backend: "postgres" (Docker, valor por defecto) o "sqlite" (npm start).
# `npm start` fija DB_CLIENT=sqlite automáticamente e ignora las variables de PostgreSQL.
DB_CLIENT=postgres
POSTGRES_USER=claimshield
POSTGRES_PASSWORD=claimshield
POSTGRES_DB=claimshield
BACKEND_PORT=3000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
# Solo modo sqlite: ruta del archivo (por defecto backend/data/claimshield.db; ":memory:" para pruebas; una ruta relativa se resuelve desde la raíz del repo)
# SQLITE_PATH=backend/data/claimshield.db
